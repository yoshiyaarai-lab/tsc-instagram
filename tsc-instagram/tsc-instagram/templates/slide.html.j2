<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<style>
  :root{
    --main:#1AAEE6;      /* 水色（メイン） */
    --main-deep:#0A8FD0;
    --sky:#29DBF5;
    --pale:#E8F7FD;
    --grid:#CDEBF8;
    --navy:#12324D;
    --text:#24384A;
    --muted:#5E7385;
    --white:#FFFFFF;
    --mint:#4CCFA3;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{width:1080px;height:1350px;overflow:hidden}
  body{
    font-family:"Noto Sans CJK JP","Noto Sans JP",sans-serif;
    color:var(--text);
    background:var(--white);
    -webkit-font-smoothing:antialiased;
  }
  .canvas{position:relative;width:1080px;height:1350px;overflow:hidden;}
  .grid-bg{
    position:absolute;inset:0;
    background-color:#F3FAFE;
    background-image:
      linear-gradient(var(--grid) 2px, transparent 2px),
      linear-gradient(90deg, var(--grid) 2px, transparent 2px);
    background-size:72px 72px;
  }
  .hl{
    color:var(--main-deep);
    background:linear-gradient(transparent 62%, rgba(41,219,245,.38) 62%);
    padding:0 .04em;
  }

  /* ---------- 表紙 ---------- */
  .cover-band{
    position:absolute;left:0;right:0;top:250px;height:790px;background:var(--white);
    border-top:4px solid var(--navy);border-bottom:4px solid var(--navy);
  }
  .topic-pill{
    position:absolute;left:50%;top:250px;transform:translate(-50%,-50%);
    background:var(--white);border:4px solid var(--navy);border-radius:22px;
    padding:14px 46px 18px;font-size:54px;font-weight:900;color:var(--navy);
    letter-spacing:.01em;white-space:nowrap;font-family:"Noto Sans CJK JP",sans-serif;
  }
  .cover-inner{position:absolute;left:0;right:0;top:330px;height:640px;
    display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 60px;}
  .cover-cat{
    font-size:50px;font-weight:900;color:var(--white);
    background:var(--main);border-radius:999px;padding:6px 40px 10px;margin-bottom:46px;
    box-shadow:0 8px 0 var(--main-deep);
  }
  .cover-title{font-size:{{ slide.title_size|default(92) }}px;line-height:1.32;font-weight:900;color:var(--navy);letter-spacing:.01em;}
  .cover-title .hl{color:var(--main);background:linear-gradient(transparent 70%, rgba(41,219,245,.35) 70%);}
  .cover-sub{margin-top:40px;font-size:36px;font-weight:700;color:var(--muted);line-height:1.5}
  .cover-logo{position:absolute;left:46px;bottom:92px;width:170px;background:#fff;border-radius:24px;padding:10px;border:3px solid var(--navy)}
  .badge{
    position:absolute;right:64px;top:120px;width:210px;height:210px;z-index:3;border-radius:50%;
    background:var(--main);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;
    font-weight:900;transform:rotate(10deg);box-shadow:0 10px 0 var(--main-deep);
  }
  .badge .b1{font-size:30px;line-height:1.2}
  .badge .b2{font-size:52px;line-height:1.2}
  .swipe{
    position:absolute;right:56px;bottom:120px;font-size:40px;font-weight:900;color:var(--navy);
    background:var(--white);border:4px solid var(--navy);border-radius:999px;padding:12px 40px 16px;
    display:flex;align-items:center;gap:16px;
  }
  .swipe .arr{color:var(--main);font-size:46px}
  .cover-foot{position:absolute;left:240px;bottom:140px;font-size:30px;font-weight:700;color:var(--navy);
    background:var(--white);padding:8px 20px;border-radius:12px;}

  /* ---------- 本文スライド共通 ---------- */
  .header{position:absolute;left:0;right:0;top:0;height:150px;display:flex;align-items:center;
    justify-content:space-between;padding:0 56px;}
  .header .tag{display:flex;align-items:center;gap:18px;font-size:32px;font-weight:900;color:var(--navy);}
  .header .tag img{width:92px}
  .header .tag span{background:var(--white);border:3px solid var(--navy);border-radius:999px;padding:4px 26px 8px;}
  .page{font-size:34px;font-weight:900;color:var(--white);background:var(--navy);border-radius:999px;padding:4px 28px 8px;}
  .card{
    position:absolute;left:48px;right:48px;top:150px;bottom:100px;background:var(--white);
    border:4px solid var(--navy);border-radius:36px;padding:56px 60px 50px;
    box-shadow:0 14px 0 var(--main);
    display:flex;flex-direction:column;
  }
  .heading{font-size:{{ 62 }}px;font-weight:900;color:var(--navy);line-height:1.35;margin-bottom:38px;}
  .heading .num{display:inline-block;color:var(--main);margin-right:10px;}
  .lead{font-size:34px;line-height:1.65;color:var(--text);font-weight:500;margin:-14px 0 34px;}
  .footer-note{position:absolute;left:0;right:0;bottom:30px;text-align:center;font-size:28px;font-weight:700;color:var(--navy);}
  .footer-note b{color:var(--main-deep)}

  /* points */
  .points{display:flex;flex-direction:column;gap:34px;flex:1;justify-content:center}
  .point{flex:1;display:flex;flex-direction:column;justify-content:center}
  .point{background:var(--pale);border-radius:26px;padding:32px 36px 34px;position:relative;}
  .point-title{display:flex;align-items:flex-start;gap:20px;font-size:47px;font-weight:900;color:var(--navy);line-height:1.35;}
  .point-title .n{flex:none;width:68px;height:68px;border-radius:50%;background:var(--main);color:#fff;
    display:flex;align-items:center;justify-content:center;font-size:38px;margin-top:-2px;}
  .point-body{margin-top:18px;font-size:36px;line-height:1.7;font-weight:500;color:var(--text);padding-left:88px;}

  .points.many{gap:24px}
  .points.many .point{padding:24px 32px 26px}
  .points.many .point-title{font-size:42px}
  .points.many .point-title .n{width:60px;height:60px;font-size:34px}
  .points.many .point-body{font-size:32px;line-height:1.6;margin-top:10px;padding-left:80px}
  /* steps */
  .steps{display:flex;flex-direction:column;gap:0;flex:1;justify-content:center}
  .step{display:flex;align-items:stretch;gap:26px;}
  .step-rail{flex:none;width:76px;display:flex;flex-direction:column;align-items:center;}
  .step-rail .dot{width:76px;height:76px;border-radius:50%;background:var(--main);color:#fff;font-size:40px;font-weight:900;
    display:flex;align-items:center;justify-content:center;}
  .step-rail .line{flex:1;width:6px;background:var(--grid);margin:6px 0;}
  .step:last-child .line{display:none}
  .step-text{padding:6px 0 30px;flex:1}
  .step-title{font-size:47px;font-weight:900;color:var(--navy);line-height:1.35}
  .step-title small{font-size:32px;color:var(--main-deep);font-weight:900;margin-left:12px}
  .step-body{font-size:34px;line-height:1.55;color:var(--muted);font-weight:500;margin-top:6px}

  /* compare */
  .cmp{display:flex;flex-direction:column;gap:26px;flex:1;justify-content:center}
  .cmp-box{border-radius:26px;padding:30px 36px 34px;}
  .cmp-box.bad{background:#F2F4F6;}
  .cmp-box.good{background:var(--pale);border:4px solid var(--main);}
  .cmp-label{display:inline-block;font-size:34px;font-weight:900;border-radius:999px;padding:2px 26px 6px;margin-bottom:16px;color:#fff;}
  .bad .cmp-label{background:#8A99A6}
  .good .cmp-label{background:var(--main)}
  .cmp-text{font-size:37px;line-height:1.65;font-weight:500;color:var(--text)}
  .bad .cmp-text{color:#5b6670}
  .cmp-arrow{text-align:center;font-size:56px;color:var(--main);line-height:1;margin:-8px 0;}
  .cmp-why{font-size:33px;line-height:1.6;color:var(--muted);font-weight:500;margin-top:6px}

  /* example */
  .example{background:var(--pale);border-radius:26px;padding:40px 44px;font-size:34px;line-height:1.8;font-weight:500;flex:1;position:relative}
  .example p+p{margin-top:8px}
  .example .tagline{display:inline-block;background:var(--main);color:#fff;font-weight:900;font-size:26px;border-radius:8px;padding:0 12px 3px;margin-right:12px;vertical-align:3px}
  .chars{margin-top:20px;text-align:right;font-size:28px;color:var(--muted);font-weight:700}

  /* list / checklist */
  .groups{display:flex;flex-direction:column;gap:34px;flex:1;justify-content:center}
  .group-title{font-size:40px;font-weight:900;color:var(--main-deep);margin-bottom:12px;}
  .qlist{list-style:none;display:flex;flex-direction:column;gap:18px}
  .qlist li{display:flex;gap:18px;align-items:flex-start;font-size:38px;line-height:1.5;font-weight:700;color:var(--text);
    background:var(--pale);border-radius:18px;padding:24px 28px 26px;}
  .qlist li .ic{flex:none;color:var(--main);font-weight:900}
  .qlist.ng li{background:#F2F4F6;color:#5b6670}
  .qlist.ng li .ic{color:#E0586A}

  /* summary */
  .check{list-style:none;display:flex;flex-direction:column;gap:18px;margin-bottom:34px}
  .check li{display:flex;gap:20px;align-items:flex-start;font-size:37px;line-height:1.45;font-weight:700;color:var(--navy);
    border-bottom:3px dashed var(--grid);padding-bottom:18px}
  .check li .box{flex:none;width:46px;height:46px;border:4px solid var(--main);border-radius:10px;margin-top:4px;position:relative}
  .check li .box::after{content:"";position:absolute;left:10px;top:1px;width:14px;height:26px;border-right:6px solid var(--main);border-bottom:6px solid var(--main);transform:rotate(45deg)}
  .cta{margin-top:auto;background:linear-gradient(135deg,var(--main),var(--sky));border-radius:30px;padding:34px 40px;color:#fff;
    display:flex;align-items:center;gap:30px}
  .cta img{width:150px;background:#fff;border-radius:24px;padding:10px}
  .cta .t1{font-size:42px;font-weight:900;line-height:1.35}
  .cta .t2{font-size:28px;font-weight:700;opacity:.95;margin-top:8px;line-height:1.5}
</style>
</head>
<body>
<div class="canvas">
  <div class="grid-bg"></div>

{% if slide.type == "cover" %}
  <div class="cover-band"></div>
  <div class="topic-pill">Today’s Topic</div>
  <div class="cover-inner">
    <div class="cover-cat">{{ slide.category }}</div>
    <div class="cover-title">{{ slide.title|md }}</div>
    {% if slide.sub %}<div class="cover-sub">{{ slide.sub|md }}</div>{% endif %}
  </div>
  <img class="cover-logo" src="{{ logo }}">
  {% if slide.badge %}
  <div class="badge"><div class="b1">{{ slide.badge[0] }}</div><div class="b2" {% if slide.badge[1]|length > 2 %}style="font-size:40px"{% endif %}>{{ slide.badge[1] }}</div></div>
  {% endif %}
  <div class="cover-foot">筑波大の就活サークル TSC</div>
  <div class="swipe">スワイプ <span class="arr">→</span></div>

{% else %}
  <div class="header">
    <div class="tag"><img src="{{ logo }}"><span>{{ post.short }}</span></div>
    <div class="page">{{ index }} / {{ total }}</div>
  </div>
  <div class="card">
    {% if slide.heading %}<div class="heading">{{ slide.heading|md }}</div>{% endif %}
    {% if slide.lead %}<div class="lead">{{ slide.lead|md }}</div>{% endif %}

    {% if slide.type == "points" %}
      <div class="points {% if slide["items"]|length > 2 %}many{% endif %}">
      {% for p in slide["items"] %}
        <div class="point">
          <div class="point-title"><span class="n">{{ p.n }}</span><span>{{ p.title|md }}</span></div>
          <div class="point-body">{{ p.body|md }}</div>
        </div>
      {% endfor %}
      </div>

    {% elif slide.type == "steps" %}
      <div class="steps">
      {% for s in slide["items"] %}
        <div class="step">
          <div class="step-rail"><div class="dot">{{ loop.index }}</div><div class="line"></div></div>
          <div class="step-text">
            <div class="step-title">{{ s.title|md }}{% if s.tag %}<small>{{ s.tag }}</small>{% endif %}</div>
            {% if s.body %}<div class="step-body">{{ s.body|md }}</div>{% endif %}
          </div>
        </div>
      {% endfor %}
      </div>

    {% elif slide.type == "compare" %}
      <div class="cmp">
        <div class="cmp-box bad"><div class="cmp-label">{{ slide.bad_label|default("NG例") }}</div><div class="cmp-text">{{ slide.bad|md }}</div></div>
        <div class="cmp-arrow">▼</div>
        <div class="cmp-box good"><div class="cmp-label">{{ slide.good_label|default("OK例") }}</div><div class="cmp-text">{{ slide.good|md }}</div></div>
        {% if slide.why %}<div class="cmp-why">{{ slide.why|md }}</div>{% endif %}
      </div>

    {% elif slide.type == "example" %}
      <div class="example">
        {% for para in slide.paragraphs %}<p>{% if para.tag %}<span class="tagline">{{ para.tag }}</span>{% endif %}{{ para.text|md }}</p>{% endfor %}
        {% if slide.chars %}<div class="chars">{{ slide.chars }}</div>{% endif %}
      </div>

    {% elif slide.type == "lists" %}
      <div class="groups">
      {% for g in slide.groups %}
        <div>
          <div class="group-title">{{ g.title }}</div>
          <ul class="qlist {% if g.ng %}ng{% endif %}">
            {% for q in g["items"] %}<li><span class="ic">{% if g.ng %}✕{% else %}Q{% endif %}</span><span>{{ q|md }}</span></li>{% endfor %}
          </ul>
        </div>
      {% endfor %}
      </div>

    {% elif slide.type == "summary" %}
      <ul class="check">
        {% for c in slide["items"] %}<li><span class="box"></span><span>{{ c|md }}</span></li>{% endfor %}
      </ul>
      <div class="cta">
        <img src="{{ logo }}">
        <div>
          <div class="t1">{{ slide.cta|default("保存して、あとで見返そう！")|md }}</div>
          <div class="t2">{{ slide.cta_sub|default("フォローすると、筑波大生向けの就活情報が週3回届きます")|md }}</div>
        </div>
      </div>
    {% endif %}
  </div>
  {% if slide.note %}<div class="footer-note">{{ slide.note|md }}</div>{% endif %}
{% endif %}
</div>
</body>
</html>
